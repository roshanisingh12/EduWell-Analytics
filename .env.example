# =====================================================================
# EduWell Analytics - Runtime Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# All variables can be prefixed with EDUWELL_ or specified directly.
# =====================================================================

# Server network binding
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Data & session limits
MAX_UPLOAD_MB=25
MAX_ROWS=100000
SESSION_TTL_MINUTES=120
MAX_SESSIONS=200
ANALYSIS_WAIT_SECONDS=60

# Security & CORS
# Comma-separated list of allowed origins (leave empty to disable CORS headers)
CORS_ORIGINS=
# Set to true in production behind HTTPS
COOKIE_SECURE=false

# API Documentation
ENABLE_DOCS=true

# File storage paths
# WORK_DIR=/tmp/eduwell
# SAMPLE_PATH=./student_lifestyle_dataset.csv
